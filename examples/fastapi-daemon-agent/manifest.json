{
  "name": "fastapi-daemon-agent",
  "version": "1.0.0",
  "description": "Daemon agent with FastAPI endpoint exposed to host",
  "language": "python",
  "entrypoint": "src/agent.py",
  "timeout_seconds": 0,
  "runtime_mode": "daemon",
  "daemon_auto_start": true,
  "deployment": "container",
  "health_check": {
    "type": "http",
    "path": "/health",
    "port": 8000,
    "interval_seconds": 30,
    "timeout_seconds": 5
  },
  "expose": {
    "port": 8000,
    "health_check_path": "/health"
  },
  "restart_policy": "on-failure",
  "environment": {
    "DAEMON_PORT": "8000",
    "APP_NAME": "FastAPI Daemon Agent"
  }
}
