{
  "info": {
    "_postman_id": "2f1f5893-a5bf-4e9c-9dc8-8c56f7d3465f",
    "name": "Crucible API Integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('baseUrl')) {",
          "  pm.collectionVariables.set('baseUrl', pm.environment.get('baseUrl') || 'http://127.0.0.1:8000');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "providerId", "value": "" },
    { "key": "providerName", "value": "" },
    { "key": "packageId", "value": "" },
    { "key": "scheduleId", "value": "" },
    { "key": "secretId", "value": "" },
    { "key": "runId", "value": "" }
  ],
  "item": [
    {
      "name": "Health - OpenAPI",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/openapi.json",
          "host": ["{{baseUrl}}"],
          "path": ["openapi.json"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('OpenAPI available', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('OpenAPI is JSON', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Packages - List and Capture First Package",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/packages",
          "host": ["{{baseUrl}}"],
          "path": ["packages"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Packages endpoint returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "var data = []; try { data = pm.response.json(); } catch (e) {}",
              "pm.test('Packages response is an array', function () {",
              "  pm.expect(Array.isArray(data)).to.be.true;",
              "});",
              "pm.test('Package list check completed', function () {",
              "  pm.expect(Array.isArray(data)).to.be.true;",
              "});",
              "if (data.length > 0) {",
              "  pm.collectionVariables.set('packageId', String(data[0].id));",
              "  pm.collectionVariables.set('hasPackage', 'true');",
              "} else {",
              "  pm.collectionVariables.unset('packageId');",
              "  pm.collectionVariables.set('hasPackage', 'false');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "LLM Providers - Create",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const unique = Date.now();",
              "pm.collectionVariables.set('providerName', 'anthropic');",
              "pm.collectionVariables.set('providerDescription', 'Postman integration provider ' + unique);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create provider returns 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "var body = {}; try { body = pm.response.json(); } catch (e) {}",
              "pm.collectionVariables.set('providerId', String(body.id));",
              "pm.test('Provider created with credentials metadata only', function () {",
              "  pm.expect(body.provider).to.eql(pm.collectionVariables.get('providerName'));",
              "  pm.expect(body).to.have.property('credential_keys');",
              "  pm.expect(body).to.not.have.property('credentials');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"provider_name\": \"{{providerName}}\",\n  \"description\": \"{{providerDescription}}\",\n  \"endpoint\": \"https://api.anthropic.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/llm-providers",
          "host": ["{{baseUrl}}"],
          "path": ["llm-providers"]
        }
      }
    },
    {
      "name": "LLM Providers - Get By Id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/llm-providers/{{providerId}}",
          "host": ["{{baseUrl}}"],
          "path": ["llm-providers", "{{providerId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Get provider returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "var body = {}; try { body = pm.response.json(); } catch (e) {}",
              "pm.test('Provider id matches captured id', function () {",
              "  pm.expect(String(body.id)).to.eql(pm.collectionVariables.get('providerId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "LLM Providers - Update",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"provider_name\": \"{{providerName}}\",\n  \"description\": \"Updated by Postman automation\",\n  \"endpoint\": \"https://api.anthropic.com/v2\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/llm-providers/{{providerId}}",
          "host": ["{{baseUrl}}"],
          "path": ["llm-providers", "{{providerId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Update provider returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "var body = {}; try { body = pm.response.json(); } catch (e) {}",
              "pm.test('Provider description updated', function () {",
              "  pm.expect(body.description).to.eql('Updated by Postman automation');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Flow Gate - Package Dependent",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/openapi.json",
          "host": ["{{baseUrl}}"],
          "path": ["openapi.json"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('hasPackage') === 'true') {",
              "  pm.test('Package-dependent flow enabled', function () { pm.expect(true).to.be.true; });",
              "  pm.execution.setNextRequest('Schedules - Create');",
              "} else {",
              "  pm.test('Package-dependent flow skipped (no package data)', function () { pm.expect(true).to.be.true; });",
              "  pm.execution.setNextRequest('Cleanup - Delete LLM Provider');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Schedules - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"schedule_type\": \"interval\",\n  \"interval_seconds\": 3600,\n  \"enabled\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/packages/{{packageId}}/schedules",
          "host": ["{{baseUrl}}"],
          "path": ["packages", "{{packageId}}", "schedules"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create schedule returns 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "var body = {}; try { body = pm.response.json(); } catch (e) {}",
              "pm.collectionVariables.set('scheduleId', String(body.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "Schedules - Activate",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/schedules/{{scheduleId}}/activate",
          "host": ["{{baseUrl}}"],
          "path": ["schedules", "{{scheduleId}}", "activate"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Activate schedule returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Secrets - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"key_name\": \"POSTMAN_SECRET\",\n  \"value\": \"integration-test-secret\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/packages/{{packageId}}/secrets",
          "host": ["{{baseUrl}}"],
          "path": ["packages", "{{packageId}}", "secrets"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create secret returns 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "var body = {}; try { body = pm.response.json(); } catch (e) {}",
              "pm.collectionVariables.set('secretId', String(body.id));",
              "pm.test('Secret value is not returned', function () {",
              "  pm.expect(body).to.not.have.property('value');",
              "  pm.expect(body).to.not.have.property('encrypted_value');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Runs - Create",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/runs?package_id={{packageId}}",
          "host": ["{{baseUrl}}"],
          "path": ["runs"],
          "query": [
            { "key": "package_id", "value": "{{packageId}}" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create run returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "var body = {}; try { body = pm.response.json(); } catch (e) {}",
              "pm.collectionVariables.set('runId', String(body.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "Runs - Get Logs",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/runs/{{runId}}/logs",
          "host": ["{{baseUrl}}"],
          "path": ["runs", "{{runId}}", "logs"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Get run logs returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Run logs response is an array', function () {",
              "  var logs = []; try { logs = pm.response.json(); } catch (e) {}",
              "  pm.expect(Array.isArray(logs)).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Cleanup - Delete Secret",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/packages/{{packageId}}/secrets/{{secretId}}",
          "host": ["{{baseUrl}}"],
          "path": ["packages", "{{packageId}}", "secrets", "{{secretId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Delete secret returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Cleanup - Delete Schedule",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/schedules/{{scheduleId}}",
          "host": ["{{baseUrl}}"],
          "path": ["schedules", "{{scheduleId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Delete schedule returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Cleanup - Delete LLM Provider",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/llm-providers/{{providerId}}",
          "host": ["{{baseUrl}}"],
          "path": ["llm-providers", "{{providerId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Delete provider returns 204', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
