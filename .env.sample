APP_NAME=AgentPlatform
ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=crucibleaiagents
POSTGRES_USER=[YOUR DB USERNAME HERE]
POSTGRES_PASSWORD=[YOUR DB PASSWORD HERE]
SECRETS_ENCRYPTION_KEY=[YOUR KEY HERE]
PACKAGE_WATCHER_BASE_DIR=[YOUR DIRECTORY FOR PACKAGE WATCHER HERE]
API_BASE_URL=http://localhost:8000
API_TOKEN=
WATCHER_POLL_INTERVAL=5
LOG_LEVEL=INFO

# Database aliases used by docker-compose interpolation
DB_NAME=crucibleaiagents
DB_USER=[YOUR DB USERNAME HERE]
DB_PASSWORD=[YOUR DB PASSWORD HERE]

# Worker/runtime settings
POLL_SECONDS=3
MAX_CONCURRENT_RUNS=3
SCHEDULER_CHECK_INTERVAL=5
BATCH_CONTAINER_RECONCILE_INTERVAL=30
DAEMON_HEALTH_CHECK_INTERVAL=30
DAEMON_AUTOSTART_CHECK_INTERVAL=30
DB_STARTUP_MAX_WAIT_SECONDS=120
DB_STARTUP_RETRY_INTERVAL_SECONDS=2

# AgentFlow runtime wiring
AGENTFLOW_DOCKER_NETWORK=crucibleaiagents_default
AGENTFLOW_DAEMON_DOCKER_NETWORK=crucibleaiagents-daemon
AGENTFLOW_LOG_LEVEL=INFO
AGENTFLOW_API_TOKEN=
AGENTFLOW_RUNNER_API_TOKEN=
RUNNER_IMAGE=crucibleaiagents-runner:latest
RUNNER_API_BASE_URL=http://localhost:8080
DAEMON_API_BASE_URL=http://host.docker.internal:8080
DOCKER_HOST=tcp://docker-proxy:2375
WORKSPACE_HOST_PATH=[ABSOLUTE PROJECT ROOT PATH]
WORKSPACE_PACKAGE_HOST_PATH=[ABSOLUTE PACKAGE ROOT PATH]

# Chat memory controls
LLM_CHAT_MEMORY_TTL_HOURS=168
LLM_CHAT_MEMORY_MAX_TURNS=20
LLM_CHAT_MEMORY_READ_LIMIT_DEFAULT=100
LLM_CHAT_MEMORY_READ_LIMIT_MAX=500
LLM_CHAT_MEMORY_SUMMARIZATION_TRIGGER_TURNS=8
LLM_CHAT_MEMORY_SUMMARY_INPUT_MAX_MESSAGES=40

# MCP integration
MCP_SERVER_URL=http://mcp_server:9001/mcp
MCP_CLIENT_TIMEOUT_SECONDS=20
MCP_SERVER_AUTH_TOKEN=
MCP_CLIENT_ORCHESTRATION=auto
MCP_CHAT_TOOLING_ENABLED=false
MCP_CHAT_TOOLING_MAX_TOOLS=3
MCP_CHAT_TOOLING_MAX_RESULT_CHARS=4000
MCP_SERVER_PORT=9001
MCP_SERVER_PATH=/mcp
MCP_ENABLED_TOOLS=
MCP_DISABLED_TOOLS=
MCP_ALLOWED_WEB_HOSTS=
MCP_WEB_REQUEST_TIMEOUT_SECONDS=10
MCP_RESOURCE_HOST_PATH=[ABSOLUTE HOST DIRECTORY TO EXPOSE TO MCP]
MCP_RESOURCE_MOUNT_PATH=/mnt/mcp-resources
MCP_RESOURCE_ROOTS=/workspace,/mnt/mcp-resources
MCP_RESOURCE_ALLOWED_EXTENSIONS=.txt,.md,.json,.yaml,.yml,.csv,.log,.py,.js,.ts,.docx,.pdf
MCP_RESOURCE_MAX_FILE_BYTES=1048576
MCP_RESOURCE_MAX_LIST_ENTRIES=200
TAVILY_API_KEY=
MCP_SECRET_RESOLVER_BASE_URL=http://api:8000
MCP_SECRET_RESOLVER_TIMEOUT_SECONDS=10
MCP_SECRET_RESOLVER_TOKEN=